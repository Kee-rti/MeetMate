# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Google OAuth 2.0 (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# App settings — use a long random string in production
APP_SECRET_KEY=change_me_to_a_random_secret_string
REDIRECT_URI=http://localhost:8000/oauth/callback

# Optional: set to "true" to enable demo mode without real credentials
DEMO_MODE=false
